---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { categoryLabels } from '@/lib/categories';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	category,
	heroImage,
	heroImageAlt,
	heroImageCredit,
} = Astro.props;

const categoryLabel = categoryLabels[category];
const formattedDate = pubDate.toLocaleDateString('en-US', {
	weekday: 'short',
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});

const postUrl = new URL(Astro.url.pathname, Astro.site).href;
const modifiedDate = updatedDate ?? pubDate;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: modifiedDate.toISOString(),
	author: {
		'@type': 'Person',
		name: 'Ronald te Brake',
	},
	publisher: {
		'@type': 'Person',
		name: 'Ronald te Brake',
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': postUrl,
	},
	url: postUrl,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
	<div class="px-6 py-32 lg:px-8">
		<div class="mx-auto max-w-3xl text-base leading-7">
			<header class="not-prose mx-auto mb-10 w-full max-w-2xl text-center">
				<h1 class="text-3xl font-bold tracking-tight text-primary-950 dark:text-primary-200 sm:text-4xl">
					{title}
				</h1>
				<p
					class="mx-auto mt-4 max-w-2xl text-lg italic text-coolGray-600 dark:text-coolGray-400"
				>
					{description}
				</p>
			</header>

			{heroImage ? (
				<figure class="not-prose mx-auto mb-12 w-full max-w-2xl">
					<Image
						src={heroImage}
						class="w-full rounded-2xl object-cover sm:rounded-3xl"
						alt={heroImageAlt ?? ''}
					/>
					<figcaption class="mt-4 flex flex-col gap-2 text-sm text-coolGray-500 dark:text-coolGray-400 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
						<span class="text-left">{formattedDate}</span>
						<a
							href={`/category/${category}/`}
							class="text-left uppercase transition hover:underline sm:text-right"
						>
							{categoryLabel}
						</a>
					</figcaption>
					{heroImageCredit && (
						<p class="mt-3 text-sm text-coolGray-500 dark:text-primary-300">
							Photo by{' '}
							<a href={heroImageCredit.url} rel="noopener noreferrer" target="_blank" class="underline">
								{heroImageCredit.photoBy}
							</a>
							.
						</p>
					)}
				</figure>
			) : (
				<div class="not-prose mx-auto mb-12 flex max-w-2xl flex-col gap-2 text-sm text-coolGray-500 dark:text-coolGray-400 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
					<span class="text-left">{formattedDate}</span>
					<a
						href={`/category/${category}/`}
						class="text-left uppercase transition hover:underline sm:text-right"
					>
						{categoryLabel}
					</a>
				</div>
			)}

			<article
				class="format format-sm sm:format-base lg:format-lg format-blue prose lg:prose-xl dark:text-primary-200 mx-auto w-full max-w-2xl text-coolGray-600 prose-headings:scroll-mt-24"
			>
				<slot />
			</article>
		</div>
	</div>
	<div
		id="blog-image-lightbox"
		class="blog-image-lightbox"
		hidden
		role="dialog"
		aria-modal="true"
		aria-label="Full size image"
		tabindex="-1"
	>
		<button type="button" class="blog-image-lightbox-close" aria-label="Close full size image">
			&times;
		</button>
		<img class="blog-image-lightbox-img" alt="" decoding="async" />
	</div>
	<script is:inline>
		function initBlogImageLightbox() {
			const lightbox = document.getElementById('blog-image-lightbox');
			const lightboxImg = lightbox?.querySelector('.blog-image-lightbox-img');
			const closeButton = lightbox?.querySelector('.blog-image-lightbox-close');
			if (!lightbox || !lightboxImg || !closeButton) return;

			document.body.appendChild(lightbox);

			let lastTrigger = null;

			function lightboxSrcFromImg(img) {
				const src = img.currentSrc || img.src;
				if (!src) return '';

				try {
					const url = new URL(src, window.location.href);

					if (url.pathname === '/_image/') {
						const href = url.searchParams.get('href');
						if (href) {
							const decoded = decodeURIComponent(href);
							const origWidth = decoded.match(/origWidth=(\d+)/)?.[1];
							if (origWidth) {
								url.searchParams.set('w', origWidth);
								url.searchParams.delete('h');
							}
						}
					}

					return url.href;
				} catch {
					return src;
				}
			}

			function openLightbox(trigger) {
				const img = trigger.querySelector('img');
				const src = img ? lightboxSrcFromImg(img) : '';
				if (!src) return;

				lastTrigger = trigger;
				lightboxImg.src = src;
				lightboxImg.alt = img?.alt ?? '';
				lightbox.removeAttribute('hidden');
				document.body.style.overflow = 'hidden';
				closeButton.focus();
			}

			function closeLightbox() {
				lightbox.setAttribute('hidden', '');
				lightboxImg.removeAttribute('src');
				lightboxImg.alt = '';
				document.body.style.overflow = '';
				lastTrigger?.focus();
				lastTrigger = null;
			}

			document.addEventListener('click', (event) => {
				const trigger = event.target.closest('article .blog-image-link');
				if (!trigger) return;

				event.preventDefault();
				openLightbox(trigger);
			});

			closeButton.addEventListener('click', closeLightbox);

			lightbox.addEventListener('click', (event) => {
				if (event.target === lightbox) {
					closeLightbox();
				}
			});

			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && !lightbox.hasAttribute('hidden')) {
					closeLightbox();
				}
			});
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', initBlogImageLightbox);
		} else {
			initBlogImageLightbox();
		}
	</script>
</BaseLayout>
